APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Nuxt SPA origin for CORS + Sanctum stateful (cookie) auth.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Engine driver: `stub` (fixed contract payloads, default) or `subprocess`
# (runs the real Python engine/engine.py). See config/engine.php.
# Set ENGINE_DRIVER=stub if you have no Python/engine locally.
ENGINE_DRIVER=subprocess
ENGINE_PYTHON=python3
# ENGINE_SCRIPT / ENGINE_CWD default to ../engine (override only if it lives elsewhere).
# ENGINE_SCRIPT=/abs/path/to/engine/engine.py
# ENGINE_CWD=/abs/path/to/engine
# Timeouts in seconds: ENGINE_TIMEOUT for request-time calls (search, chat);
# ENGINE_JOB_TIMEOUT for queued generate/transcribe/book jobs (download + ffmpeg
# + whisper take minutes). `php artisan queue:work` picks it up automatically.
# DB_QUEUE_RETRY_AFTER defaults to ENGINE_JOB_TIMEOUT + 120; if you set it, keep it higher.
ENGINE_TIMEOUT=120
ENGINE_JOB_TIMEOUT=1800

# Engine secrets/overrides: Laravel exports this file to the environment, so the
# engine subprocess inherits anything set here (see engine/.env.example for the
# full list). Needed for semantic search, chat and book with real answers:
# GEMINI_API_KEY=AIza...your-key
# COFFEE_OUTPUT_DIR=/abs/path/to/engine/output

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
