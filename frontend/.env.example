# Base URL of the API the frontend talks to (never the Python engine directly).
# Default is the local Laravel api/ — run `php artisan serve` AND
# `php artisan queue:work` (generate/transcribe/book are queued jobs).
# See docs/local-e2e-setup.md.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# Examples:
#   local dev (default):  NUXT_PUBLIC_API_BASE=http://localhost:8000/api
#   production:           NUXT_PUBLIC_API_BASE=https://api.cortado.example/api
# It is read at runtime (Nuxt public runtimeConfig), so a built image can be
# repointed without rebuilding.
